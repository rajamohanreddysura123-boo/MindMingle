<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- 1. Pure Pitch Black Background -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,0h512v512h-512z" />

    <!-- 2. Frosted Glass Container Card -->
    <path
        android:pathData="M160,64 L352,64 A96,96 0,0 1 448,160 L448,352 A96,96 0,0 1 352,448 L160,448 A96,96 0,0 1 64,352 L64,160 A96,96 0,0 1 160,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="64"
                android:startY="64"
                android:endX="448"
                android:endY="448"
                android:type="linear">
                <item android:offset="0.0" android:color="#24FFFFFF" />
                <item android:offset="0.5" android:color="#0DFFFFFF" />
                <item android:offset="1.0" android:color="#04FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Glass Rim Highlight Outline -->
    <path
        android:pathData="M160,64 L352,64 A96,96 0,0 1 448,160 L448,352 A96,96 0,0 1 352,448 L160,448 A96,96 0,0 1 64,352 L64,160 A96,96 0,0 1 160,64 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#35FFFFFF" />

    <!-- 4. Frosted Glass Border Contour Framing the Letter 'M' -->
    <path
        android:pathData="M 160,352 V 176 L 256,272 L 352,176 V 352"
        android:strokeWidth="42"
        android:strokeColor="#50FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 5. Core Monogram 'M' (Primary Color #D6A87C) -->
    <path
        android:pathData="M 160,352 V 176 L 256,272 L 352,176 V 352"
        android:strokeWidth="30"
        android:strokeColor="#FFD6A87C"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
